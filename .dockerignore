# VCS
.git
.gitignore
.github

# Node
**/node_modules
web/dist
**/*.tsbuildinfo

# Built frontend: the node stage regenerates this so the image never ships a
# stale bundle baked in from a developer's working tree.
cmd/goff-studio/dist
backends/s3/cmd/goff-studio-s3/dist

# Locally built binaries
/goff-studio
/go-app

# Local config and secrets
studio.yaml
*.pem
*.key
.env
.env.*

# Packaging / docs that never affect the build
Dockerfile
.dockerignore
charts
README.md
LICENSE
*.md
